{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SeanShaffer88/WinDevKit/blob/main/schemas/release-evidence-v1.schema.json",
  "title": "Portfolio release evidence v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "recorded_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree_state": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        }
      },
      "required": [
        "repository",
        "commit",
        "tree_state"
      ],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "enum": [
            "development",
            "prerelease",
            "stable"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "signing": {
          "enum": [
            "unsigned",
            "signed",
            "not_applicable"
          ]
        },
        "signing_detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tag",
        "maturity",
        "url",
        "signing",
        "signing_detail"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "kind": {
            "enum": [
              "build",
              "lint",
              "test",
              "consumer",
              "package"
            ]
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        },
        "required": [
          "id",
          "status",
          "kind",
          "platform",
          "detail",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "real_machine": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "passed",
            "partial",
            "not_run"
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidence": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      },
      "required": [
        "status",
        "platform",
        "operations",
        "evidence"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "architecture": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "size",
          "url",
          "architecture"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "url",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "recorded_on",
    "project",
    "source",
    "release",
    "checks",
    "real_machine",
    "artifacts",
    "notices",
    "limitations"
  ],
  "additionalProperties": false
}
